generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  RETURNED
  FAILED
}

enum MarketplaceType {
  SHOPEE
  TOKOPEDIA
  LAZADA
  OTHER
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum StockTransactionType {
  ADD_STOCK
  REMOVE_STOCK
  STOCK_OPNAME
  ORDER
  ORDER_CANCEL
  RETURN_IN
  RETURN_OUT
  TRANSFER
  MARKETPLACE_SYNC
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  OPNAME
  MARKETPLACE
}

enum StockOpnameStatus {
  DRAFT
  POSTED
  COMPLETED
}

enum WarehouseType {
  MAIN
  STORE
  TRANSIT
  RETURN
}

enum PaymentStatus {
  UNPAID
  PAID
  SETTLED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  OTHER
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SYNC
  IMPORT
  EXPORT
  PRINT
  SCAN
  APPROVE
  REJECT
}

enum ActivityModule {
  AUTH
  USER
  PRODUCT
  CATEGORY
  BRAND
  MARKETPLACE
  ORDER
  WAREHOUSE
  STOCK
  PURCHASE
  SALES
  REPORT
  SETTING
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  IMPORT
  EXPORT
  SYNC
  PRINT
  SCAN
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  action      AuditAction
  oldData     Json?       @map("old_data")
  newData     Json?       @map("new_data")
  changes     Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  requestId   String?     @map("request_id")
  createdAt   DateTime    @map("created_at") @default(now())

  user        User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @map("setting_key") @unique
  settingValue Json     @map("setting_value")
  description  String?
  createdById  String?  @map("created_by") @db.Uuid
  updatedById  String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @map("created_at") @default(now())
  updatedAt    DateTime @map("updated_at") @updatedAt

  createdBy    User?    @relation("SystemSettingCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_settings")
  @@index([settingKey])
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  type        NotificationType
  title       String
  message     String
  status      NotificationStatus
  payload     Json?              
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @map("created_at") @default(now())

  user        User               @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  module      ActivityModule
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id")
  action      ActivityAction
  title       String
  description String?
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  metadata    Json?
  createdAt   DateTime       @map("created_at") @default(now())

  user        User?          @relation(fields: [userId], references: [id])

  @@map("activity_logs")
  @@index([userId])
  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String?
  status        UserStatus     @default(ACTIVE)
  isActive      Boolean        @map("is_active") @default(true)
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @map("created_at") @default(now())
  updatedAt     DateTime       @map("updated_at") @updatedAt
  deletedAt     DateTime?      @map("deleted_at")
  createdById   String?        @map("created_by") @db.Uuid
  updatedById   String?        @map("updated_by") @db.Uuid

  createdBy     User?          @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?          @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers  User[]         @relation("UserCreatedBy")
  updatedUsers  User[]         @relation("UserUpdatedBy")
  userRoles     UserRole[]
  rolesCreated  Role[]         @relation("RoleCreatedBy")
  rolesUpdated  Role[]         @relation("RoleUpdatedBy")
  permissionsCreated Permission[] @relation("PermissionCreatedBy")
  permissionsUpdated Permission[] @relation("PermissionUpdatedBy")
  userRolesCreated UserRole[]   @relation("UserRoleCreatedBy")
  userRolesUpdated UserRole[]   @relation("UserRoleUpdatedBy")
  rolePermissionsCreated RolePermission[] @relation("RolePermissionCreatedBy")
  rolePermissionsUpdated RolePermission[] @relation("RolePermissionUpdatedBy")
  categoriesCreated Category[]  @relation("CategoryCreatedBy")
  categoriesUpdated Category[]  @relation("CategoryUpdatedBy")
  brandsCreated Brand[]         @relation("BrandCreatedBy")
  brandsUpdated Brand[]         @relation("BrandUpdatedBy")
  attributesCreated Attribute[] @relation("AttributeCreatedBy")
  attributesUpdated Attribute[] @relation("AttributeUpdatedBy")
  attributeValuesCreated AttributeValue[] @relation("AttributeValueCreatedBy")
  attributeValuesUpdated AttributeValue[] @relation("AttributeValueUpdatedBy")
  productAttributesCreated ProductAttribute[] @relation("ProductAttributeCreatedBy")
  productAttributesUpdated ProductAttribute[] @relation("ProductAttributeUpdatedBy")
  productsCreated Product[]    @relation("ProductCreatedBy")
  productsUpdated Product[]    @relation("ProductUpdatedBy")
  stocksCreated StockMovement[] @relation("StockMovementCreatedBy")
  stockOpnamesCreated StockOpname[] @relation("StockOpnameCreatedBy")
  stockOpnamesCompleted StockOpname[] @relation("StockOpnameCompletedBy")
  productVariantsCreated ProductVariant[] @relation("ProductVariantCreatedBy")
  productVariantsUpdated ProductVariant[] @relation("ProductVariantUpdatedBy")
  productMediaCreated ProductMedia[] @relation("ProductMediaCreatedBy")
  productMediaUpdated ProductMedia[] @relation("ProductMediaUpdatedBy")
  productPriceHistoriesChangedBy ProductPriceHistory[] @relation("ProductPriceHistoryChangedBy")
  stockTransactionsCreated StockTransaction[]
  stockOpnameSessionsCreated StockOpnameSession[]
  ordersCreated Order[]         @relation("OrderCreatedBy")
  activityLogs ActivityLog[]
  auditLogs    AuditLog[]
  systemSettingsCreated SystemSetting[] @relation("SystemSettingCreatedBy")
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")
  notifications Notification[]

  @@map("users")
  @@index([status])
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @unique
  description   String?
  createdAt     DateTime         @map("created_at") @default(now())
  updatedAt     DateTime         @map("updated_at") @updatedAt
  deletedAt     DateTime?        @map("deleted_at")
  createdById   String?          @map("created_by") @db.Uuid
  updatedById   String?          @map("updated_by") @db.Uuid

  createdBy     User?            @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  userRoles     UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @unique
  description   String?
  createdAt     DateTime         @map("created_at") @default(now())
  updatedAt     DateTime         @map("updated_at") @updatedAt
  deletedAt     DateTime?        @map("deleted_at")
  createdById   String?          @map("created_by") @db.Uuid
  updatedById   String?          @map("updated_by") @db.Uuid

  createdBy     User?            @relation("PermissionCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?            @relation("PermissionUpdatedBy", fields: [updatedById], references: [id])
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  assignedAt    DateTime @map("assigned_at") @default(now())
  createdAt     DateTime @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at") @updatedAt
  deletedAt     DateTime? @map("deleted_at")
  createdById   String?  @map("created_by") @db.Uuid
  updatedById   String?  @map("updated_by") @db.Uuid

  user          User     @relation(fields: [userId], references: [id])
  role          Role     @relation(fields: [roleId], references: [id])
  createdBy     User?    @relation("UserRoleCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?    @relation("UserRoleUpdatedBy", fields: [updatedById], references: [id])

  @@map("user_roles")
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionId  String   @map("permission_id") @db.Uuid
  createdAt     DateTime @map("created_at") @default(now())
  updatedAt     DateTime @map("updated_at") @updatedAt
  deletedAt     DateTime? @map("deleted_at")
  createdById   String?  @map("created_by") @db.Uuid
  updatedById   String?  @map("updated_by") @db.Uuid

  role          Role     @relation(fields: [roleId], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id])
  createdBy     User?      @relation("RolePermissionCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?      @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id])

  @@map("role_permissions")
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Category {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  slug          String      @unique
  parentId      String?     @map("parent_id") @db.Uuid
  path          String?
  depth         Int?
  createdAt     DateTime    @map("created_at") @default(now())
  updatedAt     DateTime    @map("updated_at") @updatedAt
  deletedAt     DateTime?   @map("deleted_at")
  createdById   String?     @map("created_by") @db.Uuid
  updatedById   String?     @map("updated_by") @db.Uuid

  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]  @relation("CategoryHierarchy")
  attributes    Attribute[]
  products      Product[]

  createdBy     User?       @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?       @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])

  @@map("categories")
  @@index([parentId])
}

model Brand {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique
  externalId    String?     @map("external_id")
  createdAt     DateTime    @map("created_at") @default(now())
  updatedAt     DateTime    @map("updated_at") @updatedAt
  deletedAt     DateTime?   @map("deleted_at")
  createdById   String?     @map("created_by") @db.Uuid
  updatedById   String?     @map("updated_by") @db.Uuid

  createdBy     User?       @relation("BrandCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?       @relation("BrandUpdatedBy", fields: [updatedById], references: [id])
  products      Product[]

  @@map("brands")
}

model Attribute {
  id            String           @id @default(uuid()) @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  name          String
  inputType     String           @map("input_type")
  isMandatory   Boolean          @map("is_mandatory") @default(false)
  createdAt     DateTime         @map("created_at") @default(now())
  updatedAt     DateTime         @map("updated_at") @updatedAt
  deletedAt     DateTime?        @map("deleted_at")
  createdById   String?          @map("created_by") @db.Uuid
  updatedById   String?          @map("updated_by") @db.Uuid

  category      Category         @relation(fields: [categoryId], references: [id])
  values        AttributeValue[]
  productAttributes ProductAttribute[]

  createdBy     User?            @relation("AttributeCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?            @relation("AttributeUpdatedBy", fields: [updatedById], references: [id])

  @@map("attributes")
  @@index([categoryId])
}

model AttributeValue {
  id            String      @id @default(uuid()) @db.Uuid
  attributeId   String      @map("attribute_id") @db.Uuid
  value         String
  externalId    String?     @map("external_id")
  createdAt     DateTime    @map("created_at") @default(now())
  updatedAt     DateTime    @map("updated_at") @updatedAt
  deletedAt     DateTime?   @map("deleted_at")
  createdById   String?     @map("created_by") @db.Uuid
  updatedById   String?     @map("updated_by") @db.Uuid

  attribute     Attribute   @relation(fields: [attributeId], references: [id])
  productAttributes ProductAttribute[]

  createdBy     User?       @relation("AttributeValueCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?       @relation("AttributeValueUpdatedBy", fields: [updatedById], references: [id])

  @@map("attribute_values")
  @@index([attributeId])
}

model ProductAttribute {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  attributeId        String      @map("attribute_id") @db.Uuid
  attributeValueId   String?     @map("attribute_value_id") @db.Uuid
  valueText          String?     @map("value_text")
  createdAt          DateTime    @map("created_at") @default(now())
  updatedAt          DateTime    @map("updated_at") @updatedAt
  deletedAt          DateTime?   @map("deleted_at")
  createdById        String?     @map("created_by") @db.Uuid
  updatedById        String?     @map("updated_by") @db.Uuid

  attribute          Attribute    @relation(fields: [attributeId], references: [id])
  attributeValue     AttributeValue? @relation(fields: [attributeValueId], references: [id])
  createdBy          User?        @relation("ProductAttributeCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?        @relation("ProductAttributeUpdatedBy", fields: [updatedById], references: [id])

  @@map("product_attributes")
  @@index([productId])
  @@index([attributeId])
}

model Product {
  id            String     @id @default(uuid()) @db.Uuid
  productCode   String     @map("product_code") @unique
  name          String
  description   String?
  categoryId    String?    @map("category_id") @db.Uuid
  brandId       String?    @map("brand_id") @db.Uuid
  status        ProductStatus @default(ACTIVE)
  weight        Float?
  createdAt     DateTime   @map("created_at") @default(now())
  updatedAt     DateTime   @map("updated_at") @updatedAt
  deletedAt     DateTime?  @map("deleted_at")
  createdById   String?    @map("created_by") @db.Uuid
  updatedById   String?    @map("updated_by") @db.Uuid

  category      Category?  @relation(fields: [categoryId], references: [id])
  brand         Brand?     @relation(fields: [brandId], references: [id])
  variants      ProductVariant[]
  media         ProductMedia[]
  stocks        Stock[]
  priceHistory  ProductPriceHistory[]
  marketplaceListings ProductMarketplaceListing[]
  marketplaceMappings MarketplaceMapping[]

  createdBy     User?      @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?      @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  @@map("products")
  @@index([status])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id               String        @id @default(uuid()) @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  sku              String
  name             String?
  hpp              Float?        @map("hpp")
  sellingPrice     Float?        @map("selling_price")
  weight           Float?
  barcode          String?       @map("barcode")
  status           ProductStatus @default(ACTIVE)
  variationOptions Json?         @map("variation_options")
  createdAt        DateTime      @map("created_at") @default(now())
  updatedAt        DateTime      @map("updated_at") @updatedAt
  deletedAt        DateTime?     @map("deleted_at")
  createdById      String?       @map("created_by") @db.Uuid
  updatedById      String?       @map("updated_by") @db.Uuid

  product          Product       @relation(fields: [productId], references: [id])
  priceHistory     ProductPriceHistory[]
  listingVariants  MarketplaceListingVariant[]
  marketplaceMappings MarketplaceMapping[]
  stockBalances    StockBalance[]
  stockTransactions StockTransaction[]
  opnameLines      StockOpnameLine[]
  orderItems       OrderItem[]

  createdBy        User?         @relation("ProductVariantCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?         @relation("ProductVariantUpdatedBy", fields: [updatedById], references: [id])

  @@map("product_variants")
  @@unique([productId, sku])
  @@index([sku])
  @@index([productId])
}

model ProductMedia {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  type          MediaType
  url           String
  mimeType      String?     @map("mime_type")
  metadata      Json?       @map("metadata")
  createdAt     DateTime    @map("created_at") @default(now())
  updatedAt     DateTime    @map("updated_at") @updatedAt
  deletedAt     DateTime?   @map("deleted_at")
  createdById   String?     @map("created_by") @db.Uuid
  updatedById   String?     @map("updated_by") @db.Uuid

  product       Product     @relation(fields: [productId], references: [id])
  createdBy     User?       @relation("ProductMediaCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?       @relation("ProductMediaUpdatedBy", fields: [updatedById], references: [id])

  @@map("product_media")
  @@index([productId])
}

model ProductPriceHistory {
  id                String      @id @default(uuid()) @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  productVariantId  String?     @map("product_variant_id") @db.Uuid
  priceType         String      @map("price_type")
  oldValue          Float?      @map("old_value")
  newValue          Float?      @map("new_value")
  changedAt         DateTime    @map("changed_at") @default(now())
  changedById       String?     @map("changed_by") @db.Uuid
  createdAt         DateTime    @map("created_at") @default(now())
  updatedAt         DateTime    @map("updated_at") @updatedAt
  deletedAt         DateTime?   @map("deleted_at")

  product           Product     @relation(fields: [productId], references: [id])
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id])
  changedBy         User?       @relation("ProductPriceHistoryChangedBy", fields: [changedById], references: [id])

  @@map("product_price_history")
  @@index([productId])
  @@index([productVariantId])
  @@index([priceType])
}

model ProductMarketplaceListing {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  marketplaceId      String?     @map("marketplace_id") @db.Uuid
  marketplaceShopId  String?     @map("marketplace_shop_id") @db.Uuid
  marketplaceProductId String?   @map("marketplace_product_id")
  marketplaceSku     String?     @map("marketplace_sku")
  externalItemId     String?     @map("external_item_id")
  externalItemSku    String?     @map("external_item_sku")
  status             String?
  syncStatus         SyncStatus? @map("sync_status")
  lastSyncedAt       DateTime?   @map("last_synced_at")
  externalData       Json?       @map("external_data")
  createdAt          DateTime    @map("created_at") @default(now())
  updatedAt          DateTime    @map("updated_at") @updatedAt
  deletedAt          DateTime?   @map("deleted_at")

  product            Product     @relation(fields: [productId], references: [id])
  marketplace        Marketplace? @relation(fields: [marketplaceId], references: [id])
  marketplaceShop    MarketplaceShop? @relation(fields: [marketplaceShopId], references: [id])
  variants           MarketplaceListingVariant[]

  @@map("product_marketplace_listings")
  @@index([productId])
  @@index([marketplaceId])
  @@index([marketplaceShopId])
  @@index([marketplaceProductId])
  @@index([marketplaceSku])
  @@index([syncStatus])
  @@unique([marketplaceShopId, marketplaceProductId])
  @@unique([marketplaceShopId, externalItemId])
}

model MarketplaceListingVariant {
  id                    String   @id @default(uuid()) @db.Uuid
  marketplaceListingId  String   @map("marketplace_listing_id") @db.Uuid
  productVariantId      String?  @map("product_variant_id") @db.Uuid
  marketplaceVariantId  String?  @map("marketplace_variant_id")
  marketplaceSku        String?  @map("marketplace_sku")
  externalSkuId         String?  @map("external_sku_id")
  variationName         String?  @map("variation_name")
  price                 Float?
  stock                 Int?
  status                String? 
  active                Boolean? @default(true)

  listing               ProductMarketplaceListing @relation(fields: [marketplaceListingId], references: [id])
  productVariant        ProductVariant?          @relation(fields: [productVariantId], references: [id])

  @@map("marketplace_listing_variants")
  @@unique([marketplaceListingId, marketplaceVariantId])
  @@index([productVariantId])
  @@index([marketplaceVariantId])
  @@index([marketplaceSku])
}

model MarketplaceMapping {
  id                String      @id @default(uuid()) @db.Uuid
  marketplaceId     String?     @map("marketplace_id") @db.Uuid
  marketplaceShopId String?     @map("marketplace_shop_id") @db.Uuid
  erpProductId      String?     @map("erp_product_id") @db.Uuid
  erpVariantId      String?     @map("erp_variant_id") @db.Uuid
  marketplaceProductId String?  @map("marketplace_product_id")
  marketplaceSku    String?     @map("marketplace_sku")
  marketplaceSkuId  String?     @map("marketplace_sku_id")
  status            String?
  lastSyncAt        DateTime?   @map("last_sync_at")
  createdAt         DateTime    @map("created_at") @default(now())
  updatedAt         DateTime    @map("updated_at") @updatedAt
  deletedAt         DateTime?   @map("deleted_at")

  marketplace       Marketplace? @relation(fields: [marketplaceId], references: [id])
  marketplaceShop   MarketplaceShop? @relation(fields: [marketplaceShopId], references: [id])
  product           Product?    @relation(fields: [erpProductId], references: [id])
  productVariant    ProductVariant? @relation(fields: [erpVariantId], references: [id])

  @@map("marketplace_mappings")
  @@index([marketplaceId])
  @@index([marketplaceShopId])
  @@index([erpProductId])
  @@index([erpVariantId])
  @@index([marketplaceProductId])
  @@index([marketplaceSku])
}

model Marketplace {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  slug         String      @unique
  vendorCode   String      @map("vendor_code") @unique
  logo         String?
  isActive     Boolean     @map("is_active") @default(true)
  createdAt    DateTime    @map("created_at") @default(now())
  updatedAt    DateTime    @map("updated_at") @updatedAt
  deletedAt    DateTime?   @map("deleted_at")

  shops        MarketplaceShop[]
  listings     ProductMarketplaceListing[]
  mappings     MarketplaceMapping[]

  @@map("marketplaces")
  @@index([slug])
  @@index([vendorCode])
}

model MarketplaceShop {
  id                String      @id @default(uuid()) @db.Uuid
  marketplaceId     String      @map("marketplace_id") @db.Uuid
  shopName          String      @map("shop_name")
  shopId            String      @map("shop_id")
  sellerId          String      @map("seller_id")
  refreshToken      String?     @map("refresh_token")
  accessToken       String?     @map("access_token")
  tokenExpiredAt    DateTime?   @map("token_expired_at")
  autoSyncProduct   Boolean     @map("auto_sync_product") @default(false)
  autoSyncStock     Boolean     @map("auto_sync_stock") @default(false)
  autoSyncOrder     Boolean     @map("auto_sync_order") @default(false)
  autoSyncPrice     Boolean     @map("auto_sync_price") @default(false)
  connected         Boolean     @default(false)
  lastSyncedAt      DateTime?   @map("last_synced_at")
  createdAt         DateTime    @map("created_at") @default(now())
  updatedAt         DateTime    @map("updated_at") @updatedAt
  deletedAt         DateTime?   @map("deleted_at")

  marketplace       Marketplace @relation(fields: [marketplaceId], references: [id])
  listings          ProductMarketplaceListing[]
  syncLogs          MarketplaceSyncLog[]
  mappings          MarketplaceMapping[]

  @@map("marketplace_shops")
  @@unique([marketplaceId, shopId])
  @@unique([marketplaceId, sellerId])
  @@index([marketplaceId])
  @@index([shopId])
  @@index([sellerId])
}

model MarketplaceSyncLog {
  id                 String      @id @default(uuid()) @db.Uuid
  marketplaceShopId  String      @map("marketplace_shop_id") @db.Uuid
  syncType           String      @map("sync_type")
  syncStatus         SyncStatus  @map("sync_status")
  startedAt          DateTime    @map("started_at") @default(now())
  finishedAt         DateTime?   @map("finished_at")
  successCount       Int         @map("success_count") @default(0)
  failedCount        Int         @map("failed_count") @default(0)
  skippedCount       Int         @map("skipped_count") @default(0)
  message            String?     
  detail             Json?
  createdAt          DateTime    @map("created_at") @default(now())
  updatedAt          DateTime    @map("updated_at") @updatedAt
  deletedAt          DateTime?   @map("deleted_at")

  marketplaceShop    MarketplaceShop @relation(fields: [marketplaceShopId], references: [id])

  @@map("marketplace_sync_logs")
  @@index([marketplaceShopId])
  @@index([syncStatus])
}

model Warehouse {
  id          String      @id @default(uuid()) @db.Uuid
  code        String?     @unique
  name        String
  type        WarehouseType @default(MAIN)
  isActive    Boolean     @map("is_active") @default(true)
  location    String?     
  description String?
  createdAt   DateTime    @map("created_at") @default(now())
  updatedAt   DateTime    @map("updated_at") @updatedAt
  deletedAt   DateTime?   @map("deleted_at")

  stockBalances     StockBalance[]
  stockTransactions StockTransaction[]
  opnameSessions    StockOpnameSession[]
  stocks            Stock[]
  stockOpnames      StockOpname[]

  @@map("warehouses")
  @@index([code])
  @@index([type])
}

model Stock {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  warehouseId   String        @map("warehouse_id") @db.Uuid
  qty           Int           @default(0)
  minimumStock  Int           @map("minimum_stock") @default(0)
  createdAt     DateTime      @map("created_at") @default(now())
  updatedAt     DateTime      @map("updated_at") @updatedAt
  deletedAt     DateTime?     @map("deleted_at")

  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  movements     StockMovement[]
  opnameItems   StockOpnameItem[]

  @@map("stocks")
  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockMovement {
  id            String           @id @default(uuid()) @db.Uuid
  stockId       String           @map("stock_id") @db.Uuid
  productId     String?          @map("product_id") @db.Uuid
  type          StockMovementType
  qty           Int
  beforeQty     Int              @map("before_qty")
  afterQty      Int              @map("after_qty")
  adjustmentQty Int?             @map("adjustment_qty")
  reason        String?
  reference     String?
  note          String?
  createdById   String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @map("created_at") @default(now())

  stock         Stock            @relation(fields: [stockId], references: [id])
  createdBy     User?            @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@map("stock_movements")
  @@index([stockId])
  @@index([createdById])
}

model StockOpname {
  id            String             @id @default(uuid()) @db.Uuid
  warehouseId   String             @map("warehouse_id") @db.Uuid
  opnameDate    DateTime           @map("opname_date") @default(now())
  status        StockOpnameStatus  @default(DRAFT)
  notes         String?            @map("notes")
  createdById   String?            @map("created_by") @db.Uuid
  completedById String?            @map("completed_by") @db.Uuid
  completedAt   DateTime?          @map("completed_at")
  createdAt     DateTime           @map("created_at") @default(now())

  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy     User?              @relation("StockOpnameCreatedBy", fields: [createdById], references: [id])
  completedBy   User?              @relation("StockOpnameCompletedBy", fields: [completedById], references: [id])
  items         StockOpnameItem[]

  @@map("stock_opnames")
  @@index([warehouseId])
  @@index([createdById])
  @@index([completedById])
}

model StockOpnameItem {
  id              String        @id @default(uuid()) @db.Uuid
  stockOpnameId   String        @map("stock_opname_id") @db.Uuid
  stockId         String        @map("stock_id") @db.Uuid
  systemQty       Int           @map("system_qty") @default(0)
  physicalQty     Int           @map("physical_qty") @default(0)
  differenceQty   Int           @map("difference_qty") @default(0)

  stockOpname     StockOpname   @relation(fields: [stockOpnameId], references: [id])
  stock           Stock         @relation(fields: [stockId], references: [id])

  @@map("stock_opname_items")
  @@unique([stockOpnameId, stockId])
  @@index([stockOpnameId])
  @@index([stockId])
}

model StockBalance {
  id               String        @id @default(uuid()) @db.Uuid
  warehouseId      String        @map("warehouse_id") @db.Uuid
  productVariantId String        @map("product_variant_id") @db.Uuid
  quantity         Int           @default(0)
  reservedQuantity Int           @map("reserved_quantity") @default(0)
  createdAt        DateTime      @map("created_at") @default(now())
  updatedAt        DateTime      @map("updated_at") @updatedAt
  deletedAt        DateTime?     @map("deleted_at")

  warehouse        Warehouse     @relation(fields: [warehouseId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  transactions     StockTransaction[]
  opnameLines      StockOpnameLine[]

  @@map("stock_balances")
  @@unique([warehouseId, productVariantId])
  @@index([warehouseId])
  @@index([productVariantId])
}

model StockTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  warehouseId        String               @map("warehouse_id") @db.Uuid
  productVariantId   String               @map("product_variant_id") @db.Uuid
  stockBalanceId     String?              @map("stock_balance_id") @db.Uuid
  transactionType    StockTransactionType @map("transaction_type")
  quantity           Int
  beforeQuantity     Int?                 @map("before_quantity")
  changeQuantity     Int?                 @map("change_quantity")
  afterQuantity      Int?                 @map("after_quantity")
  reference          String?              @map("reference")
  referenceType      String?              @map("reference_type")
  referenceId        String?              @map("reference_id")
  createdById        String?              @map("created_by") @db.Uuid
  notes              String?              @map("notes")
  occurredAt         DateTime             @map("occurred_at") @default(now())
  createdAt          DateTime             @map("created_at") @default(now())
  updatedAt          DateTime             @map("updated_at") @updatedAt
  deletedAt          DateTime?            @map("deleted_at")

  warehouse          Warehouse            @relation(fields: [warehouseId], references: [id])
  productVariant     ProductVariant       @relation(fields: [productVariantId], references: [id])
  stockBalance       StockBalance?        @relation(fields: [stockBalanceId], references: [id])
  createdBy          User?                @relation(fields: [createdById], references: [id])

  @@map("stock_transactions")
  @@index([warehouseId])
  @@index([productVariantId])
  @@index([stockBalanceId])
  @@index([transactionType])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdById])
}

model StockOpnameSession {
  id             String       @id @default(uuid()) @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  sessionCode    String?      @map("session_code") @unique
  status         String?
  createdById    String?      @map("created_by") @db.Uuid
  startedAt      DateTime?    @map("started_at")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @map("created_at") @default(now())
  updatedAt      DateTime     @map("updated_at") @updatedAt
  deletedAt      DateTime?    @map("deleted_at")

  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  createdBy      User?        @relation(fields: [createdById], references: [id])
  lines          StockOpnameLine[]

  @@map("stock_opname_sessions")
  @@index([warehouseId])
  @@index([createdById])
}

model StockOpnameLine {
  id                String            @id @default(uuid()) @db.Uuid
  sessionId         String            @map("session_id") @db.Uuid
  productVariantId  String            @map("product_variant_id") @db.Uuid
  stockBalanceId    String?           @map("stock_balance_id") @db.Uuid
  expectedQuantity  Int?              @map("expected_quantity")
  countedQuantity   Int?              @map("counted_quantity")
  difference        Int?              @map("difference")
  notes             String?           @map("notes")
  createdAt         DateTime          @map("created_at") @default(now())
  updatedAt         DateTime          @map("updated_at") @updatedAt
  deletedAt         DateTime?         @map("deleted_at")

  session           StockOpnameSession @relation(fields: [sessionId], references: [id])
  productVariant    ProductVariant     @relation(fields: [productVariantId], references: [id])
  stockBalance      StockBalance?      @relation(fields: [stockBalanceId], references: [id])

  @@map("stock_opname_lines")
  @@unique([sessionId, productVariantId])
  @@index([sessionId])
  @@index([productVariantId])
  @@index([stockBalanceId])
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String?  @map("external_id")
  name        String
  email       String?  @unique
  phone       String?  @unique
  address     String?  
  city        String?
  postalCode  String?  @map("postal_code")
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  orders      Order[]

  @@map("customers")
  @@index([email])
  @@index([phone])
}

model Courier {
  id          String   @id @default(uuid()) @db.Uuid
  code        String?  @unique
  name        String
  phone       String?
  description String?
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  orders      Order[]

  @@map("couriers")
  @@index([code])
}

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  orderNumber        String?      @map("order_number") @unique
  customerId         String       @map("customer_id") @db.Uuid
  courierId          String?      @map("courier_id") @db.Uuid
  createdById        String?      @map("created_by") @db.Uuid
  orderDate          DateTime?    @map("order_date")
  status             String?
  voucherStore       Float?       @map("voucher_store") @default(0)
  voucherMarketplace Float?       @map("voucher_marketplace") @default(0)
  campaignDiscount   Float?       @map("campaign_discount") @default(0)
  adminFee           Float?       @map("admin_fee") @default(0)
  serviceFee         Float?       @map("service_fee") @default(0)
  shippingSubsidy    Float?       @map("shipping_subsidy") @default(0)
  codFee             Float?       @map("cod_fee") @default(0)
  affiliateFee       Float?       @map("affiliate_fee") @default(0)
  adsFee             Float?       @map("ads_fee") @default(0)
  shippingFee        Float?       @map("shipping_fee") @default(0)
  insuranceFee       Float?       @map("insurance_fee") @default(0)
  createdAt          DateTime     @map("created_at") @default(now())
  updatedAt          DateTime     @map("updated_at") @updatedAt
  deletedAt          DateTime?    @map("deleted_at")

  customer           Customer     @relation(fields: [customerId], references: [id])
  courier            Courier?     @relation(fields: [courierId], references: [id])
  createdBy          User?        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           OrderPayment[]

  @@map("orders")
  @@index([customerId])
  @@index([courierId])
  @@index([createdById])
  @@index([status])
}

model OrderItem {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  productVariantId String        @map("product_variant_id") @db.Uuid
  productName     String         @map("product_name")
  sku             String
  variantName     String?        @map("variant_name")
  sellingPrice    Float          @map("selling_price")
  quantity        Int
  createdAt       DateTime       @map("created_at") @default(now())
  updatedAt       DateTime       @map("updated_at") @updatedAt
  deletedAt       DateTime?      @map("deleted_at")

  order           Order          @relation(fields: [orderId], references: [id])
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([productVariantId])
}

model OrderStatusHistory {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  status      String
  notes       String?   @map("notes")
  changedAt   DateTime  @map("changed_at") @default(now())
  createdAt   DateTime  @map("created_at") @default(now())
  updatedAt   DateTime  @map("updated_at") @updatedAt
  deletedAt   DateTime? @map("deleted_at")

  order       Order     @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
  @@index([orderId])
  @@index([status])
}

model OrderPayment {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @map("order_id") @db.Uuid
  paymentMethod          String?   @map("payment_method")
  amount                 Float
  status                 String?
  settlementStatus       String?   @map("settlement_status")
  settlementAmount       Float?    @map("settlement_amount")
  settlementDate         DateTime? @map("settlement_date")
  externalPaymentId      String?   @map("external_payment_id")
  marketplaceSettlementId String?  @map("marketplace_settlement_id")
  createdAt              DateTime  @map("created_at") @default(now())
  updatedAt              DateTime  @map("updated_at") @updatedAt
  deletedAt              DateTime? @map("deleted_at")

  order                  Order     @relation(fields: [orderId], references: [id])

  @@map("order_payments")
  @@index([orderId])
  @@index([status])
  @@index([externalPaymentId])
}
